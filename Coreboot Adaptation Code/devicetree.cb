# SPDX-License-Identifier: GPL-2.0-only

chip soc/intel/skylake
        # Power
        register "PmConfigSlpS3MinAssert" = "2"         # 50ms
        register "PmConfigSlpS4MinAssert" = "1"         # 1s
        register "PmConfigSlpSusMinAssert" = "3"        # 500ms
        register "PmConfigSlpAMinAssert" = "3"          # 2s

        device domain 0 on
                subsystemid 0x17aa 0x382f inherit

                device ref igpu on
                        register "gfx" = "GMA_STATIC_DISPLAYS(0)"
                        register "panel_cfg" = "{
                                .up_delay_ms            = 200,
                                .down_delay_ms          =  50,
                                .cycle_delay_ms         = 600,
                                .backlight_on_delay_ms  =   1,
                                .backlight_off_delay_ms = 200,
                                .backlight_pwm_hz       = 200,
                        }"
                end

                device ref sa_thermal on end
                device ref thermal on end

                device ref sata on
                        register "SataPortsEnable[0]" = "1"
                        register "SataPortsEnable[2]" = "1"
                        register "SataPortsDevSlp[0]" = "1"
                        register "SataPortsDevSlp[2]" = "1"
                end

	            # I2C1 Controller - Touchpad
        	    device ref i2c1 on
            	    chip drivers/i2c/generic
                		register "hid" = ""SYNA2B33""
                		register "desc" = ""Synaptics Touchpad""
                		register "irq" = "ACPI_IRQ_LEVEL_LOW(GPP_C15_IRQ)"
                		#register "i2c_address" = "0x2c"
                		device i2c 2c on end
            		end
        	    end

		        # Bus to chip EC ITE8586E
                device ref lpc_espi on
                    register "serirq_mode" = "SERIRQ_CONTINUOUS"
                    register "gen1_dec" = "0x007c1601"
                    register "gen2_dec" = "0x000c15e1"
                    register "lpc_ioe"  = "LPC_IOE_EC_4E_4F |
                                               LPC_IOE_EC_62_66 |
                                               LPC_IOE_KBC_60_64"
			
			        # EC conected to the port number 0x4e
                    chip superio/ite/it8528e
				        device pnp 2e.0 off end	     # Flopy (don't exist)
				        device pnp 2e.1 off end      # Com1
				        device pnp 2e.2 off end      # Com2
				        device pnp 2e.4 off end	     # SWUC
				        device pnp 2e.5 on	     # Mouse PS/2
					        io 0x60 = 0x60
					        io 0x62 = 0x64
					        irq 0x70 = 12
				        end
                        device pnp 2e.6 on           # Keyboard PS/2
                            io 0x60 = 0x60
                            io 0x62 = 0x64
                            irq 0x70 = 1
                        end
                        device pnp 2e.11 on          # PMC1 (Energy & Batery)
                            io 0x60 = 0x62
                            io 0x62 = 0x66
                        end
                    end
                end

                device ref hda on end

        	device ref south_xhci on end

                # I2C0
                device pci 15.0 on end

                # HECI - Intel Management Engine (Neutralized)
                device pci 16.0 on end

                # PCIe Root Port 5 - Network chip Realtek RTL8111
                device ref pcie_rp5 on
                        register "PcieRpClkReqSupport[4]"               = "true"
                        register "PcieRpClkReqNumber[4]"                = "3"
                        register "PcieRpClkSrcNumber[4]"                = "3"
                        register "PcieRpAdvancedErrorReporting[4]"      = "true"
                        register "PcieRpLtrEnable[4]"                   = "true"
                end

                device ref uart0 on end
                device ref uart1 on end
                device ref uart2 on end
               
                # PMC - Power Management Controller
                device pci 1f.2 on end
                
                # SMBus - To read RAM & sensors
                device pci 1f.4 on end
        end
end
